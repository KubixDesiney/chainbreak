{
  "$defs": {
    "AuthoritySet": {
      "additionalProperties": false,
      "description": "A canonically ordered set of capability IDs.\n\nSet algebra lives here rather than in the graph package so that every layer\n-- compiler, executor, analyzer, reporter -- performs identical operations\nwith identical ordering guarantees.",
      "properties": {
        "capabilities": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "AuthoritySet",
      "type": "object"
    },
    "DelegationMechanism": {
      "description": "How authority is transferred across an edge.",
      "enum": [
        "DIRECT_ROLE_ASSUMPTION",
        "ROLE_CHAIN",
        "SESSION_POLICY_SCOPED",
        "ROLE_CHAIN_WITH_SESSION_POLICY",
        "RESOURCE_POLICY_GRANT",
        "FEDERATED_TOKEN",
        "WORKLOAD_IDENTITY"
      ],
      "title": "DelegationMechanism",
      "type": "string"
    }
  },
  "$id": "https://chainbreak.dev/schemas/credential.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Credential metadata. Never contains a secret access key, session token, or any truncation or encryption thereof (EV-1). Generated from the Pydantic model -- do not hand-edit. Regenerate with `python -m chainbreak.scenarios.export_schema`.",
  "properties": {
    "access_key_id_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Access Key Id Hash",
      "type": "string"
    },
    "credential_id": {
      "title": "Credential Id",
      "type": "string"
    },
    "edge_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edge Id"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "granted_duration_s": {
      "exclusiveMinimum": 0,
      "title": "Granted Duration S",
      "type": "integer"
    },
    "identity_id": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "title": "Identity Id",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "mechanism": {
      "$ref": "#/$defs/DelegationMechanism"
    },
    "requested_duration_s": {
      "exclusiveMinimum": 0,
      "title": "Requested Duration S",
      "type": "integer"
    },
    "scope_capabilities": {
      "$ref": "#/$defs/AuthoritySet",
      "default": {
        "capabilities": []
      }
    },
    "session_name_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Session Name Hash",
      "type": "string"
    },
    "session_policy_fingerprint": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Policy Fingerprint"
    }
  },
  "required": [
    "credential_id",
    "identity_id",
    "mechanism",
    "issued_at",
    "expires_at",
    "requested_duration_s",
    "granted_duration_s",
    "session_name_hash",
    "access_key_id_hash"
  ],
  "title": "CredentialRecord",
  "type": "object"
}
